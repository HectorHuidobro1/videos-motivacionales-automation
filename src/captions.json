[
  {
    "start": 0.0,
    "end": 1.74,
    "text": "¿Cuánto tiempo llevas"
  },
  {
    "start": 1.74,
    "end": 2.94,
    "text": "peleando con algo"
  },
  {
    "start": 2.94,
    "end": 3.64,
    "text": "que ya no"
  },
  {
    "start": 3.64,
    "end": 4.76,
    "text": "depende de ti?"
  },
  {
    "start": 5.96,
    "end": 8.14,
    "text": "El clima, la"
  },
  {
    "start": 8.14,
    "end": 9.3,
    "text": "opinión de otros,"
  },
  {
    "start": 10.62,
    "end": 12.98,
    "text": "el pasado, la"
  },
  {
    "start": 12.98,
    "end": 14.24,
    "text": "decisión que alguien"
  },
  {
    "start": 14.24,
    "end": 16.82,
    "text": "más tomó. Nada"
  },
  {
    "start": 16.82,
    "end": 17.6,
    "text": "de eso se"
  },
  {
    "start": 17.6,
    "end": 19.14,
    "text": "mueve un centímetro,"
  },
  {
    "start": 19.78,
    "end": 20.34,
    "text": "por más que"
  },
  {
    "start": 20.34,
    "end": 22.52,
    "text": "lo empujes, y"
  },
  {
    "start": 22.52,
    "end": 23.34,
    "text": "ahí está el"
  },
  {
    "start": 23.34,
    "end": 25.54,
    "text": "desgaste. No en"
  },
  {
    "start": 25.54,
    "end": 27.7,
    "text": "el problema, sino"
  },
  {
    "start": 27.7,
    "end": 28.78,
    "text": "en la resistencia"
  },
  {
    "start": 28.78,
    "end": 30.0,
    "text": "inútil contra lo"
  },
  {
    "start": 30.0,
    "end": 30.74,
    "text": "que no puedes"
  },
  {
    "start": 30.74,
    "end": 33.88,
    "text": "cambiar. Aceptar no"
  },
  {
    "start": 33.88,
    "end": 36.28,
    "text": "es rendirte. Es"
  },
  {
    "start": 36.28,
    "end": 37.28,
    "text": "soltar el peso"
  },
  {
    "start": 37.28,
    "end": 38.32,
    "text": "que nunca fue"
  },
  {
    "start": 38.32,
    "end": 40.46,
    "text": "tuyo. Para poder"
  },
  {
    "start": 40.46,
    "end": 41.76,
    "text": "usar esa energía"
  },
  {
    "start": 41.76,
    "end": 42.74,
    "text": "en lo que"
  },
  {
    "start": 42.74,
    "end": 43.66,
    "text": "sí depende de"
  },
  {
    "start": 43.66,
    "end": 46.14,
    "text": "ti. Tu esfuerzo,"
  },
  {
    "start": 47.12,
    "end": 49.12,
    "text": "tu actitud, tu"
  },
  {
    "start": 49.12,
    "end": 51.9,
    "text": "próximo paso. La"
  },
  {
    "start": 51.9,
    "end": 52.78,
    "text": "calma no llega"
  },
  {
    "start": 52.78,
    "end": 54.34,
    "text": "cuando controla todo."
  },
  {
    "start": 55.66,
    "end": 56.7,
    "text": "Llega cuando dejas"
  },
  {
    "start": 56.7,
    "end": 59.66,
    "text": "de intentarlo. Suel"
  },
  {
    "start": 59.66,
    "end": 60.18,
    "text": "tal lo que"
  },
  {
    "start": 60.18,
    "end": 61.54,
    "text": "no es tuyo."
  },
  {
    "start": 62.5,
    "end": 63.38,
    "text": "Enfoca de en"
  },
  {
    "start": 63.38,
    "end": 64.06,
    "text": "lo que sí."
  },
  {
    "start": 65.46,
    "end": 66.54,
    "text": "Ahí empieza tu"
  },
  {
    "start": 66.54,
    "end": 66.9,
    "text": "vas."
  }
]